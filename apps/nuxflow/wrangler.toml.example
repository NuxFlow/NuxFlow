name = "nuxflow"
main = ".output/server/index.mjs"
compatibility_date = "2026-04-01"
compatibility_flags = ["nodejs_compat"]

[build]
command = "pnpm run build"

[assets]
directory = ".output/public"

# Raises this Worker's CPU-time ceiling from the Paid-plan default (30s) to the platform
# max. The whole-instance D1 export (server/utils/d1-export.ts) and the WordPress import
# route both do heavy string work (escaping/hex-encoding large SQL/HTML payloads) over
# real production data sizes — CLAUDE.md documents this feature already tripping five
# separate other platform ceilings (isolate memory, D1 query limits, etc.), so budget
# CPU time generously too rather than wait for a sixth failure mode in production.
[limits]
cpu_ms = 300000

[vars]
# Set production values in the Cloudflare dashboard or via:
#   wrangler secret put SECRET_NAME
# All names below are install-wide fallbacks read via Nuxt runtimeConfig — the NUXT_
# prefix is required for Nuxt to pick them up. Cloudflare Images, S3, and Bunny.net are
# also configurable per-site in Settings → Media, which takes priority over these.
# NUXT_BETTER_AUTH_SECRET =
# NUXT_CLOUDFLARE_IMAGES_TOKEN =
# NUXT_CLOUDFLARE_ACCOUNT_ID =
#
# S3-compatible storage (checked after Cloudflare Images)
# NUXT_S3_BUCKET =
# NUXT_S3_ACCESS_KEY =
# NUXT_S3_SECRET_KEY =
# NUXT_S3_REGION = "us-east-1"
# NUXT_S3_ENDPOINT =
# NUXT_S3_PUBLIC_URL =
#
# Bunny.net storage (checked last, after Cloudflare Images and S3)
# NUXT_BUNNY_API_KEY =
# NUXT_BUNNY_STORAGE_ZONE =
# NUXT_BUNNY_PULL_ZONE =
#
# AI provider: openai | anthropic | gemini | deepseek | ollama — also configurable
# per-site in Settings → AI, which takes priority over these.
# NUXT_AI_PROVIDER =
# NUXT_OPENAI_API_KEY =
# NUXT_ANTHROPIC_API_KEY =
# NUXT_GEMINI_API_KEY =
# NUXT_DEEPSEEK_API_KEY =
# NUXT_OLLAMA_URL =
# NUXT_OLLAMA_MODEL =

[triggers]
# publish-scheduled runs every minute; prune-old-data runs nightly at 3 AM UTC;
# reconcile-stuck-videos runs hourly
crons = ["* * * * *", "0 3 * * *", "0 * * * *"]

# Workers Logs — included at no extra cost on both Free and Paid plans (no separate
# observability add-on required), so there's no reason to leave this off. Several
# production-only D1/Workers failures documented in CLAUDE.md (see server/utils/d1-export.ts
# and d1-stats.ts) were only diagnosable via an ad-hoc `wrangler tail` session; this makes
# request logs (including uncaught exceptions and console output) queryable after the fact
# in the dashboard instead of only during a live tail. head_sampling_rate = 1 logs every
# request — fine at this project's expected self-hosted scale; lower it (e.g. 0.1) if a
# high-traffic deployment starts approaching the plan's monthly log-event allowance.
[observability]
enabled = true
head_sampling_rate = 1

# Dynamic plugin KV store — run to create:
#   wrangler kv namespace create PLUGIN_KV
# then paste the returned id below and in the preview_id field.
[[kv_namespaces]]
binding = "PLUGIN_KV"
id = "your-kv-namespace-id"
preview_id = "your-kv-preview-namespace-id"

# Dynamic Workers loader — spawns isolated Worker instances from code stored in KV.
# Requires compatibility_date >= 2026-03-02.
[[worker_loaders]]
binding = "LOADER"

# Cloudflare R2 bucket (optional) — native object storage for the media system, checked
# right after Cloudflare Images in server/utils/media-providers/index.ts. Zero egress
# fees, no API keys. Create with: wrangler r2 bucket create nuxflow-media
# Then enable public access on it (a custom domain, or its r2.dev subdomain) via the
# Cloudflare dashboard, and set that URL in Settings → Media → Cloudflare R2 storage
# (or the NUXT_R2_PUBLIC_URL env var).
# [[r2_buckets]]
# binding = "MEDIA_BUCKET"
# bucket_name = "nuxflow-media"

# Cloudflare Analytics Engine (optional — included in Workers Paid plan).
# Enables edge-native, cookie-free page view and event analytics.
# Create a dataset in the Cloudflare dashboard, then set the binding name to "AE".
# [[analytics_engine_datasets]]
# binding = "AE"
# dataset = "nuxflow_analytics"

# Cloudflare D1 database — the only supported production database.
# Create with: wrangler d1 create nuxflow
# Then paste the returned database_id below.
# Migrations run automatically on the first request after deployment.
[[d1_databases]]
binding = "DB"
database_name = "nuxflow"
database_id = "your-d1-database-id"

# Cloudflare Email Sending — native transactional email, no third-party account or API
# key needed (this is the recommended email provider; select "Cloudflare Email" in
# Settings → Email). Requires each sending domain to be onboarded once:
#   wrangler email sending enable <your-domain>
# Add "remote = true" if you want local dev sends to actually go out via the real
# service instead of failing with a binding-not-found error.
[[send_email]]
name = "EMAIL"
