{
  "name": "@nuxflow/app",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "build:demo": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NUXT_IS_DEMO_BUILD=true nuxt build",
    "typecheck": "nuxt typecheck",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && vitest run --config vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy",
    "ring:canary": "tsx scripts/release/canary.ts",
    "ring:promote": "tsx scripts/release/promote.ts",
    "ring:status": "tsx scripts/release/status.ts",
    "pool:create": "tsx scripts/pools/create.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/openai": "^4.0.104",
    "@better-auth/passkey": "^1.7.14",
    "@noble/hashes": "^2.3.0",
    "@nuxflow/canvas": "workspace:*",
    "@nuxflow/db": "workspace:*",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/turnstile": "^1.1.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "ai": "^7.0.155",
    "better-auth": "^1.7.14",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "postal-mime": "^4.1.4",
    "reflect-metadata": "^0.2.2",
    "stripe": "^23.0.1",
    "ulid": "^3.0.2",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.148",
    "@iconify-json/simple-icons": "^1.2.101",
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "confbox": "^0.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.154.0"
  }
}
