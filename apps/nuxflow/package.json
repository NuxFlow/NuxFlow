{
  "name": "@nuxflow/app",
  "version": "1.0.0-beta.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "build:demo": "cross-env NODE_OPTIONS=--max-old-space-size=4096 NUXT_IS_DEMO_BUILD=true nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "vitest run --config vitest.config.ts && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && vitest run --config vitest.integration.config.ts --coverage",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.86",
    "@better-auth/passkey": "^1.7.7",
    "@noble/hashes": "^2.3.0",
    "@nuxflow/canvas": "workspace:*",
    "@nuxflow/db": "workspace:*",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "ai": "^7.0.130",
    "better-auth": "^1.7.7",
    "drizzle-orm": "0.45.3",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "pinia": "^4.0.3",
    "postal-mime": "^4.0.5",
    "reflect-metadata": "^0.2.2",
    "stripe": "^22.6.2",
    "ulid": "^3.0.2",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/simple-icons": "^1.2.99",
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.6.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.145.0"
  }
}
