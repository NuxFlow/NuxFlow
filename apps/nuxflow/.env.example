# Database — Cloudflare D1 is the only supported backend.
# No env vars needed — the [[d1_databases]] binding in wrangler.toml handles the
# connection. `wrangler dev` auto-provisions a local D1 database automatically.

# Better Auth
NUXT_BETTER_AUTH_SECRET=change-me-32-chars-minimum

# Social login — Google OAuth (optional)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI to add: http://localhost:8787/api/auth/callback/google (dev, via `wrangler dev`)
#                                  https://yourdomain.com/api/auth/callback/google (prod)
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Social login — GitHub OAuth (optional)
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8787/api/auth/callback/github (dev, via `wrangler dev`)
#                              https://yourdomain.com/api/auth/callback/github (prod)
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=

# Cloudflare Images (optional)
NUXT_CLOUDFLARE_IMAGES_TOKEN=
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_IMAGES_DELIVERY_URL=

# Cloudflare Stream (optional)
NUXT_CLOUDFLARE_STREAM_TOKEN=

# Cloudflare R2 storage (optional alternative to Cloudflare Images — checked before S3/Bunny
# in priority order). Requires the MEDIA_BUCKET binding in wrangler.toml in addition to this
# public base URL (a custom domain or the bucket's r2.dev subdomain — R2 buckets are
# private by default). Setting this activates the R2 provider once the binding is present.
# NUXT_R2_PUBLIC_URL=

# S3-compatible storage (optional alternative to Cloudflare Images — checked next in
# priority order). These are per-site overridable in Settings → Media too; these env
# vars are only the install-wide fallback when no per-site value is set.
# Setting NUXT_S3_BUCKET automatically activates the S3 provider.
# NUXT_S3_BUCKET=
# NUXT_S3_ACCESS_KEY=
# NUXT_S3_SECRET_KEY=
# NUXT_S3_REGION=us-east-1
# NUXT_S3_ENDPOINT=
# NUXT_S3_PUBLIC_URL=

# Bunny.net storage (checked last, after Cloudflare Images and S3 above)
# Setting NUXT_BUNNY_API_KEY automatically activates the Bunny provider.
# NUXT_BUNNY_API_KEY=
# NUXT_BUNNY_STORAGE_ZONE=
# NUXT_BUNNY_PULL_ZONE=

# AI provider: openai | anthropic | gemini | deepseek | ollama (optional — AI features
# throw a clear 503 when unconfigured). Per-site overrides live in Settings → AI; these
# env vars are only the install-wide fallback when no per-site value is set.
# NUXT_AI_PROVIDER=openai
# NUXT_OPENAI_API_KEY=
# NUXT_ANTHROPIC_API_KEY=
# NUXT_GEMINI_API_KEY=
# NUXT_DEEPSEEK_API_KEY=
# NUXT_OLLAMA_URL=
# NUXT_OLLAMA_MODEL=

# Email provider: console | cloudflare | resend | brevo | zepto
# 'cloudflare' needs no API key — see the send_email binding in wrangler.toml instead.
NUXT_EMAIL_PROVIDER=console
NUXT_EMAIL_FROM_ADDRESS=
NUXT_RESEND_API_KEY=
NUXT_BREVO_API_KEY=
NUXT_ZEPTO_API_KEY=

# Inbound email (optional) — a domain in this Cloudflare account with Email Routing
# enabled and a catch-all rule sending to this Worker. Sites whose own domain can't
# receive through Cloudflare get <handle>+<mailbox>@<this domain>. See docs/email.md.
# NUXT_INBOUND_EMAIL_DOMAIN=in.example.com

# Payments (optional — each provider activates once its keys are set; per-site overrides
# live in Settings → Payments, same DB-first-env-fallback pattern as everything else here).
# Stripe
# NUXT_STRIPE_SECRET_KEY=
# NUXT_STRIPE_WEBHOOK_SECRET=
# Lemon Squeezy
# NUXT_LS_API_KEY=
# NUXT_LS_STORE_ID=
# NUXT_LS_WEBHOOK_SECRET=
# Paddle
# NUXT_PADDLE_API_KEY=
# NUXT_PADDLE_VENDOR_ID=
# NUXT_PADDLE_WEBHOOK_SECRET=

# Data retention (optional — sensible defaults apply if unset; see server/tasks/prune-old-data)
# NUXT_AUDIT_LOG_RETENTION_DAYS=90
# NUXT_REVISION_RETENTION_COUNT=20

# Public (exposed to client)
NUXT_PUBLIC_SITE_URL=http://localhost:8787
NUXT_PUBLIC_CLOUDFLARE_IMAGES_DELIVERY_URL=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
