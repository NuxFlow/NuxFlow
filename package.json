{
  "name": "nuxflow",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @nuxflow/app exec nuxt prepare",
    "dev": "turbo dev --filter=@nuxflow/app",
    "build": "turbo build",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "deploy": "turbo deploy --filter=@nuxflow/app",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build --filter=@nuxflow/cli --filter=create-nuxflow-app && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "turbo": "^2.11.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "pnpm": {
    "overrides": {
      "better-auth": "^1.7.5",
      "drizzle-orm": "0.45.2",
      "kysely": "^0.28.17",
      "vue": "3.5.42"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}