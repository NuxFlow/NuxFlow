{
  "name": "nuxflow",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @nuxflow/app exec nuxt prepare",
    "dev": "turbo dev --filter=@nuxflow/app",
    "build": "turbo build",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "deploy": "turbo deploy --filter=@nuxflow/app",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build --filter=@nuxflow/cli --filter=create-nuxflow-app && changeset publish",
    "ring:canary": "pnpm -C apps/nuxflow ring:canary",
    "ring:promote": "pnpm -C apps/nuxflow ring:promote",
    "ring:status": "pnpm -C apps/nuxflow ring:status",
    "nuxflow:install": "pnpm -C apps/nuxflow nuxflow:install",
    "pool:create": "pnpm -C apps/nuxflow pool:create",
    "starters:build": "pnpm -C apps/nuxflow starters:build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "turbo": "^2.11.10",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.4",
      "kysely": "^0.28.17",
      "vue": "3.5.44",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "undici@>=8.0.0 <8.10.2": "^8.10.2",
      "valibot@>=1.0.0 <1.4.2": "^1.4.2",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "launch-editor@<2.14.2": "^2.14.2",
      "@devframes/agentic@<1.3.0": "^1.3.2",
      "postcss-selector-parser@>=6.0.0 <6.1.5": "^6.1.5",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12",
      "fontless>esbuild": "^0.28.2"
    }
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
